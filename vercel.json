{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/:page*",
      "destination": "/blog/:page",
      "statusCode": 410
    },
    {
      "source": "/get-to-know",
      "destination": "https://docs.google.com/forms/d/e/1FAIpQLScAQf4cvU3DlB35vPEHcU1Ga8AfxDSRPjPJGHHaKXtyUtcq5A/viewform?usp=header",
      "statusCode": 307
    },
    {
      "source": "/past-events",
      "destination": "/speaker-series",
      "statusCode": 308
    },
    {
      "source": "/media",
      "destination": "/speaker-series",
      "statusCode": 308
    },
    {
      "source": "/research/scam",
      "destination": "https://bliss-e-v.github.io/SCAM-project-page/",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.vercel-insights.com; frame-src https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://vitals.vercel-analytics.com https://www.google-analytics.com;"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}

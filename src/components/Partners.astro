---
import { Headline } from "@components/Headline";
import Partner from "@components/Partner.astro";
import BigButton from "./BigButton";

import googleImg from "../images/logos/google-white.png";
import siliconAlleeImg from "../images/logos/silicon-allee-logo.png";
import quantCoImg from "../images/logos/quantco.png";
import kiParkImg from "../images/logos/kipark.png";
import bifoldImg from "../images/logos/bifold.png";
import onethousandImg from "../images/logos/onethousand.png";
import didaImg from "../images/logos/dida.png";
import gResearchImg from "../images/logos/g-research-dark-bg.svg";
import janeStreetImg from "../images/logos/jane-street.svg";
import muensterAiImg from "../images/logos/muenster-ai-white.svg";
import modalImg from "../images/logos/modal-white.webp";

// Order and size show how much a sponsor contributes: the main sponsors get their own row with
// large logos, the remaining sponsors follow in a second row with smaller ones.
const MAIN = "h-12 md:h-20";
const OTHER = "h-8 md:h-12";

const mainSponsors = [
    { src: gResearchImg, alt: "G-Research", url: "https://www.gresearch.com/", wrapperClass: MAIN },
    { src: modalImg, alt: "Modal", url: "https://modal.com/", wrapperClass: MAIN },
    {
        src: janeStreetImg,
        alt: "Jane Street",
        url: "https://www.janestreet.com/",
        wrapperClass: MAIN,
        imageClass: "invert",
    },
];

const otherSponsors = [
    { src: googleImg, alt: "Google", url: "https://www.google.com/", wrapperClass: OTHER },
    { src: siliconAlleeImg, alt: "Silicon Allee", url: "https://www.siliconallee.com/", wrapperClass: OTHER },
    { src: kiParkImg, alt: "KI Park", url: "https://kipark.de/", wrapperClass: OTHER },
    { src: bifoldImg, alt: "Bifold", url: "https://www.bifold.berlin/", wrapperClass: OTHER },
    { src: quantCoImg, alt: "QuantCo", url: "https://www.quantco.com/", wrapperClass: OTHER },
    { src: onethousandImg, alt: "One Thousand", url: "https://onethousand.ai/", wrapperClass: OTHER },
    { src: didaImg, alt: "dida", url: "https://dida.do/", wrapperClass: OTHER },
];

const community = [
    { src: muensterAiImg, alt: "Münster.AI", url: "https://muensterai.com/", wrapperClass: OTHER },
];

const tiers = [
    { title: "Sponsors", rows: [mainSponsors, otherSponsors] },
    { title: "Community", rows: [community] },
];
---

<div id="Partners" class="pt-32">
    <Headline level={2}>Partners</Headline>

    <p class="max-w-full md:max-w-[50%] mt-4">
        We frequently cooperate with our partners granting them access to a
        large community of AI talents while using the given resources to
        increase the quality of our events.
    </p>

    <BigButton className="mt-4">
        <a class="no-underline min-w-fit" href="mailto:partners@bliss.berlin">
            Become a Partner
        </a>
    </BigButton>

    {tiers.map(({ title, rows }) => (
        <div class="mt-10">
            <Headline level={3}>{title}</Headline>
            {rows.map((logos) => (
                <div class="mt-2 flex flex-wrap items-center max-w-full md:max-w-[75%]">
                    {logos.map((logo) => <Partner {...logo} />)}
                </div>
            ))}
        </div>
    ))}
</div>

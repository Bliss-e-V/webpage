---
import { currentMembers, alumniMembers } from "./data/members";
import { Headline } from "./Headline";
import MemberGrid from "./MemberGrid.astro";
import BigButton from "./BigButton.tsx";
---

<div class="flex items-center flex-col justify-center mb-40">
    <div id="current-members" class="text-center pt-32 mb-6">
        <Headline level={2}>Current Team</Headline>
    </div>
    <MemberGrid members={currentMembers} class="mb-12" />

    <div class="mb-24 text-center">
        <p class="text-secondary text-md sm:text-lg mb-6 max-w-2xl mx-auto">
            Want to help shape BLISS? We're looking for volunteers to join our team.
        </p>
        <BigButton className="mx-auto">
            <a href="/join" class="no-underline">
                Join the Team
            </a>
        </BigButton>
    </div>

    <div id="alumni-members" class="text-center mb-6">
        <Headline level={2}>Alumni</Headline>
    </div>
    <MemberGrid members={alumniMembers} />
</div>

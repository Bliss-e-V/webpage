---
import { Headline } from "../Headline";
import ANewsRow from "./ANewsRow.astro";
import { getNews } from "./news";

const news = await getNews(3);
---

{
    news.length > 0 && (
        <div class="flex flex-col items-center justify-center py-10 sm:my-10">
            <Headline level={2} className="mb-10 text-center">News</Headline>
            <div class="w-full max-w-4xl px-4">
                <ul class="divide-y divide-gray-800">
                    {news.map((entry) => <ANewsRow entry={entry} compact />)}
                </ul>
                <div class="mt-6 text-center">
                    <a href="/news-preview/a" class="text-secondary hover:text-primary transition-colors">All news →</a>
                </div>
            </div>
        </div>
    )
}

---
import BNewsMedia from "./BNewsMedia.astro";
import BNewsMeta from "./BNewsMeta.astro";
import { hasPage, newsHref, type NewsEntry } from "./news";

const { entry } = Astro.props as { entry: NewsEntry };
const external = !hasPage(entry);
---

<a
    href={newsHref(entry)}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener" : undefined}
    class="group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-background-secondary no-underline transition duration-300 hover:border-accent hover:shadow-[0_0_24px_-6px_var(--accent)]"
>
    <BNewsMedia entry={entry} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" />
    <div class="flex flex-1 flex-col p-5">
        <BNewsMeta entry={entry} />
        <h3 class="mt-2 text-xl font-bold leading-snug text-primary">{entry.data.title}</h3>
        <p class="mt-2 line-clamp-3 text-secondary font-light">{entry.data.summary}</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-accent transition-colors group-hover:text-[var(--accent-light)]">
            {external ? "LinkedIn ↗" : "Read more →"}
        </span>
    </div>
</a>

---
import { Headline } from "../Headline";
import { getNews, formatNewsDate } from "./news";

const news = await getNews(3);
---

<div class="relative flex flex-col items-center justify-center py-10 sm:my-10">
    <Headline level={2} className="mb-10 text-center">News</Headline>

    <div class="w-full max-w-4xl px-4">
        <ul class="grid gap-6 md:grid-cols-3">
            {
                news.map((entry) => (
                    <li class="relative border-t border-white/15 pt-4">
                        <div class="absolute -top-[5px] left-0 h-2.5 w-2.5 rounded-full border-2 border-neutral-950 bg-accent" />
                        <a href={`/news-preview/c#${entry.id}`} class="group block no-underline">
                            <p class="text-sm text-tertiary">
                                <time datetime={entry.data.date.toISOString()}>{formatNewsDate(entry.data.date)}</time>
                                <span class="mx-1">·</span>
                                <span class="text-accent">{entry.data.category}</span>
                            </p>
                            <p class="mt-1 font-bold leading-snug text-base sm:text-lg text-primary transition-colors group-hover:text-secondary">{entry.data.title}</p>
                        </a>
                    </li>
                ))
            }
        </ul>
        <div class="mt-8 text-center">
            <a href="/news-preview/c" class="text-secondary hover:text-primary transition-colors">All news →</a>
        </div>
    </div>
</div>

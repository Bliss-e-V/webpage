---
// One feed post (variant C): full body inline, long bodies are clamped by the script in news-preview/c.astro.
import { Image } from "astro:assets";
import { render } from "astro:content";
import { formatNewsDate, hasPage, type NewsEntry } from "./news";

const { entry } = Astro.props as { entry: NewsEntry };
const { title, date, summary, category, image, imageAlt, linkedin } = entry.data;
const { Content } = await render(entry);
---

<li id={entry.id} class="c-post relative mb-8 scroll-mt-32 pl-5 sm:pl-8">
    <div class="c-dot absolute left-0 top-[29px] sm:top-[37px] z-10 h-2.5 w-2.5 -translate-x-1/2 rounded-full border-2 border-neutral-950 bg-accent"></div>
    <article class="rounded-xl border border-white/10 bg-white/[0.03] p-4 sm:p-6">
        <header class="flex items-center gap-2.5 text-sm text-tertiary">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 bg-neutral-900">
                <img src="/assets/bliss-logo.webp" alt="" class="h-6 w-6 object-contain" loading="lazy" />
            </span>
            <div class="leading-snug">
                <span class="font-semibold text-primary">BLISS</span>
                <span class="mx-1">·</span>
                <time datetime={date.toISOString()}>{formatNewsDate(date)}</time>
                <span class="mx-1">·</span>
                <span class="text-accent">{category}</span>
            </div>
        </header>

        <h2 class="!mt-4 !mb-0 !text-xl sm:!text-2xl font-bold leading-snug">{title}</h2>

        <div class="c-body mt-2" data-c-body>
            {hasPage(entry) ? <Content /> : <p>{summary}</p>}
        </div>
        <button type="button" class="c-toggle mt-2 hidden cursor-pointer text-sm font-semibold text-accent hover:text-primary" data-c-toggle>
            Show more
        </button>

        {image && <Image src={image} alt={imageAlt ?? ""} widths={[480, 720, 1080]} sizes="(min-width: 768px) 700px, 100vw" class="!mt-4 !mb-0 aspect-[16/9] w-full object-cover" />}

        <footer class="mt-4 flex items-center justify-between gap-4 text-sm">
            {linkedin ? (
                <a href={linkedin} target="_blank" rel="noopener" class="!text-secondary hover:!text-primary">View on LinkedIn ↗</a>
            ) : <span />}
            <a href={`#${entry.id}`} class="!text-tertiary hover:!text-primary no-underline" aria-label={`Link to “${title}”`} title="Link to this post">#</a>
        </footer>
    </article>
</li>

<style>
    /* Smaller variant of the global `article` typography (markdown is not scoped, hence :global). */
    .c-body :global(p),
    .c-body :global(li) {
        font-size: 1rem;
        line-height: 1.65;
        text-align: left;
    }
    @media (min-width: 640px) {
        .c-body :global(p),
        .c-body :global(li) {
            font-size: 1.0625rem;
        }
    }
    .c-body :global(p) {
        margin: 0.5rem 0;
    }
    .c-body :global(h2),
    .c-body :global(h3) {
        font-size: 1.125rem;
        margin: 1rem 0 0.25rem;
    }
    .c-body :global(img) {
        margin: 0.75rem 0;
        max-height: 24rem;
        width: auto;
    }
    .c-body[data-clamped="true"] {
        max-height: 21rem;
        overflow: hidden;
        mask-image: linear-gradient(to bottom, black 65%, transparent);
    }
    .c-post:target .c-dot {
        box-shadow: 0 0 12px rgba(255, 107, 107, 0.75);
    }
    .c-post:target article {
        border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    }
</style>

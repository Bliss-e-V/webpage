---
import { Image } from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt: string;
    url?: string;
    wrapperClass?: string;
    imageClass?: string;
}
const {
    src,
    alt,
    url,
    wrapperClass = "h-14 md:h-24",
    imageClass = "",
} = Astro.props as Props;
const Link = url ? "a" : "span";
---

<div class={`${wrapperClass} mr-20 my-4`}>
    <Link href={url} target={url && "_blank"}>
        <Image
            src={src}
            alt={alt}
            inferSize
            quality="low"
            decoding="async"
            loading="lazy"
            class={`h-full w-auto ${imageClass}`}
        />
    </Link>
</div>

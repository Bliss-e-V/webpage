---
import { currentMembers } from "./data/members";
import { Headline } from "./Headline";
import MemberGrid from "./MemberGrid.astro";
import BigButton from "./BigButton.tsx";
---

<div class="flex items-center flex-col justify-center mb-40">
    <div id="team" class="text-center pt-32 mb-6">
        <Headline level={2}>Team</Headline>
    </div>
    <MemberGrid members={currentMembers} />
    <div class="mt-8 flex flex-col sm:flex-row gap-4 items-center justify-center">
        <BigButton className="mx-auto sm:mx-0">
            <a href="/team" class="no-underline">
                View Team and Alumni
            </a>
        </BigButton>
        <BigButton className="mx-auto sm:mx-0">
            <a href="/join" class="no-underline">
                Join the Team
            </a>
        </BigButton>
    </div>
</div>

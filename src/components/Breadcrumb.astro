---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site);

const jsonLD = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: currentUrl.origin },
    ...crumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 2,
      name: crumb.name,
      item: new URL(crumb.href, currentUrl.origin).toString(),
    })),
  ],
});
---

<nav aria-label="Breadcrumb" class="text-sm text-tertiary">
  <ol class="flex items-center gap-x-2 min-w-0">
    <li class="shrink-0"><a href="/" class="hover:text-primary transition-colors">Home</a></li>
    {
      crumbs.map((crumb, index) => (
        <li class:list={["flex items-center gap-x-2", index === crumbs.length - 1 ? "min-w-0" : "shrink-0"]}>
          <span aria-hidden="true">/</span>
          {index === crumbs.length - 1 ? (
            <span aria-current="page" class="truncate">{crumb.name}</span>
          ) : (
            <a href={crumb.href} class="hover:text-primary transition-colors">{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={jsonLD}></script>

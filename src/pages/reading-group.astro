---
export const prerender = true;

import EventPage from "@components/events/EventPage.astro";
import { dayToPapers, getCurrentReadingGroupSection, getReadingGroupSessionInfoForDate } from "@components/data/papers";

const currentSection = getCurrentReadingGroupSection();
const sessionInfo = currentSection?.sessionInfo;
const today = new Date();
today.setHours(0, 0, 0, 0);
const nextSessionDate = Object.keys(dayToPapers).sort().find((date) => new Date(date) >= today && !dayToPapers[date].some((paper) => paper.canceled));
const location = nextSessionDate ? getReadingGroupSessionInfoForDate(new Date(nextSessionDate))?.location : sessionInfo?.location;
const nextSessionLabel = nextSessionDate && new Date(nextSessionDate).toLocaleDateString("en-GB", { day: "numeric", month: "long", timeZone: "Europe/Berlin" });
---

<EventPage
    kind="reading-group"
    title="AI Reading Group"
    heading="Reading Group"
    description="BLISS Berlin's AI reading group meets every Monday to discuss recent machine learning research papers. Find the current schedule, location, and paper list."
    emptyMessage="No reading group sessions scheduled. Stay tuned!"
    currentPath="/reading-group"
>
    {sessionInfo && (
        <div class="mb-10 text-secondary text-md sm:text-lg">
            <div class="mb-4">
                {sessionInfo.seasonIntro && sessionInfo.semesterLabel ? (
                    <>
                        {sessionInfo.seasonIntro}{" "}
                        <strong>{sessionInfo.semesterLabel}</strong> reading group.{" "}
                        {sessionInfo.description}
                    </>
                ) : (
                    sessionInfo.description
                )}
            </div>
            {location && (
                <div class="mb-4">
                    <strong>{nextSessionLabel ? `Location for ${nextSessionLabel}:` : "Location:"}</strong>{" "}
                    <a href={location.url} target="_blank" rel="noopener noreferrer">
                        <strong>{location.name}</strong> ({location.address})
                    </a>
                </div>
            )}
            {sessionInfo.schedule && (
                <div class="mb-4">
                    <strong>Time:</strong> {sessionInfo.schedule}
                </div>
            )}
        </div>
    )}
</EventPage>

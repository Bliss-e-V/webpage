---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import CPost from "@components/news/CPost.astro";
import { getNews } from "@components/news/news";

const news = await getNews();
---

<Layout title="News" description="News from BLISS, the Berlin student association for machine learning: announcements, partnerships, event recaps and community updates." noindex>
    <Breadcrumb crumbs={[{ name: "News", href: "/news-preview/c" }]} />
    <h1 class="mt-6 sm:mt-8 text-4xl sm:text-5xl text-transparent bg-clip-text bg-red-right font-bold">News</h1>
    <div class="w-full mb-10 max-w-full border-b sm:border-b-0 h-[0px] sm:h-[1px] bg-gradient-to-r from-gray-200 to-transparent"></div>

    <div class="mx-auto max-w-3xl">
        <p class="mb-8 text-secondary sm:text-lg">Announcements, partnerships and recaps from BLISS, newest first.</p>
        <ol class="relative before:pointer-events-none before:absolute before:inset-y-0 before:left-0 before:w-px before:bg-gradient-to-b before:from-gray-700/80 before:via-gray-700/80 before:to-transparent before:content-['']">
            {news.map((entry) => <CPost entry={entry} />)}
        </ol>
    </div>
</Layout>

<script>
    // Clamp long posts to ~12 lines with a "Show more" toggle. Without JS, everything stays visible.
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    for (const body of document.querySelectorAll<HTMLElement>("[data-c-body]")) {
        const toggle = body.nextElementSibling as HTMLButtonElement;
        if (body.scrollHeight < 25 * rem) continue;
        body.dataset.clamped = "true";
        toggle.classList.remove("hidden");
        toggle.addEventListener("click", () => {
            const clamped = body.dataset.clamped !== "true";
            body.dataset.clamped = String(clamped);
            toggle.textContent = clamped ? "Show more" : "Show less";
            if (clamped) body.closest("li")?.scrollIntoView({ block: "nearest" });
        });
    }
</script>

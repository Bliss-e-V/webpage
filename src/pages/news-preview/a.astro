---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import ANewsRow from "@components/news/ANewsRow.astro";
import { getNews, NEWS_CATEGORIES } from "@components/news/news";

const news = await getNews();
const categories = NEWS_CATEGORIES.filter((c) => news.some((n) => n.data.category === c));

// Group by year, newest first (news is already sorted).
const years = new Map<number, typeof news>();
for (const entry of news) {
    const year = entry.data.date.getUTCFullYear();
    years.set(year, [...(years.get(year) ?? []), entry]);
}

const chip =
    "rounded-full border border-border px-3 py-1 text-sm text-secondary transition-colors hover:text-primary hover:border-gray-400 aria-pressed:border-transparent aria-pressed:bg-red-right aria-pressed:text-white";
---

<Layout
    title="News"
    description="News from BLISS e.V., Berlin's AI research community: announcements, new partners, event recaps and community updates."
    noindex
>
    <Breadcrumb crumbs={[{ name: "News", href: "/news-preview/a" }]} />
    <h1 class="mt-6 sm:mt-8 text-4xl sm:text-5xl text-transparent bg-clip-text bg-red-right font-bold">News</h1>
    <div class="w-full mb-8 max-w-full border-b sm:border-b-0 h-[0px] sm:h-[1px] bg-gradient-to-r from-gray-200 to-transparent"></div>

    <div id="news-a" class="max-w-4xl pb-20">
        <p class="text-lg font-light text-secondary">
            Announcements, new partners and recaps of our events. For short updates, follow us on
            <a href="https://www.linkedin.com/company/bliss-berlin/" target="_blank" rel="noopener" class="text-primary">LinkedIn</a>.
        </p>

        <div data-filters hidden class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
            <button type="button" class={chip} data-filter="all" aria-pressed="true">All</button>
            {categories.map((c) => <button type="button" class={chip} data-filter={c} aria-pressed="false">{c}</button>)}
        </div>

        {
            [...years].map(([year, entries]) => (
                <section data-year class="mt-12">
                    <h2 class="text-xs font-semibold uppercase tracking-[0.24em] text-gray-500">{year}</h2>
                    <div class="mt-2 h-px w-full bg-gradient-to-r from-gray-700 to-transparent" />
                    <ul class="divide-y divide-gray-800">
                        {entries.map((entry) => <ANewsRow entry={entry} />)}
                    </ul>
                </section>
            ))
        }
        {news.length === 0 && <p class="mt-12 text-secondary">No news yet. Stay tuned!</p>}
    </div>

    <script is:inline>
        (() => {
            // Category filter; without JS the chips stay hidden and all items are shown.
            const root = document.getElementById("news-a");
            const chips = root.querySelectorAll("[data-filter]");
            root.querySelector("[data-filters]").hidden = false;
            chips.forEach((chip) =>
                chip.addEventListener("click", () => {
                    const cat = chip.dataset.filter;
                    chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
                    root.querySelectorAll("[data-category]").forEach((item) => (item.hidden = cat !== "all" && item.dataset.category !== cat));
                    root.querySelectorAll("[data-year]").forEach((year) => (year.hidden = !year.querySelector("[data-category]:not([hidden])")));
                }),
            );
        })();
    </script>
</Layout>

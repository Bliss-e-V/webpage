---
import Layout from "../../layouts/Layout.astro";

// Temporary comparison hub for the news section variants. Remove after a variant is chosen.
const variants = [
    { key: "a", name: "A · Newsroom list", note: "Press-release style (like BSI): compact text list, category filter, year headings. Full articles on own pages." },
    { key: "b", name: "B · Cards", note: "Magazine style (like BIFOLD): big lead story, image cards below. Full articles on own pages." },
    { key: "c", name: "C · Feed", note: "Lowest effort: everything on one page, short posts inline, links to LinkedIn. Article pages optional." },
];
---

<Layout title="News variants" description="Comparison of news section designs." noindex>
    <article class="max-w-3xl">
        <h1 class="font-bold !text-transparent bg-clip-text bg-red-right pb-2">News section: variants</h1>
        <p>All variants use the same content (<code>src/content/news/</code>). Compare the news page and the homepage teaser of each.</p>
        <ul class="!mt-8 space-y-6 !list-none">
            {variants.map((v) => (
                <li class="!list-none !ml-0">
                    <h3 class="!mt-0">{v.name}</h3>
                    <p>{v.note}</p>
                    <p>
                        <a href={`/news-preview/${v.key}`}>News page</a>
                        <span class="mx-2 text-tertiary">·</span>
                        <a href={`/news-preview/home-${v.key}`}>Homepage with teaser</a>
                    </p>
                </li>
            ))}
        </ul>
    </article>
</Layout>

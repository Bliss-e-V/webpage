---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import BNewsCard from "@components/news/BNewsCard.astro";
import BNewsMedia from "@components/news/BNewsMedia.astro";
import BNewsMeta from "@components/news/BNewsMeta.astro";
import { getNews, hasPage, newsHref } from "@components/news/news";

const [lead, ...rest] = await getNews();
const leadExternal = lead && !hasPage(lead);
---

<Layout
    title="News"
    description="News from BLISS, the Berlin Learning & Intelligent Systems Society: announcements, partnerships, event recaps and community updates."
    noindex
>
    <Breadcrumb crumbs={[{ name: "News", href: "/news-preview/b" }]} />
    <h1 class="mt-6 sm:mt-8 text-4xl sm:text-5xl text-transparent bg-clip-text bg-red-right font-bold">News</h1>
    <div class="w-full mb-6 max-w-full border-b sm:border-b-0 h-[0px] sm:h-[1px] bg-gradient-to-r from-gray-200 to-transparent"></div>
    <p class="mb-10 max-w-2xl text-lg text-secondary">Announcements, new partners and looks back at our events.</p>

    {
        lead && (
            <a
                href={newsHref(lead)}
                target={leadExternal ? "_blank" : undefined}
                rel={leadExternal ? "noopener" : undefined}
                class="group grid overflow-hidden rounded-lg border border-border bg-background-secondary no-underline transition duration-300 hover:border-accent hover:shadow-[0_0_32px_-8px_var(--accent)] md:grid-cols-2"
            >
                <BNewsMedia entry={lead} sizes="(min-width: 1280px) 620px, (min-width: 768px) 50vw, 100vw" eager />
                <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
                    <BNewsMeta entry={lead} />
                    <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-primary">{lead.data.title}</h2>
                    <p class="mt-4 text-lg font-light text-secondary">{lead.data.summary}</p>
                    <span class="mt-6 font-semibold text-accent transition-colors group-hover:text-[var(--accent-light)]">
                        {leadExternal ? "LinkedIn ↗" : "Read more →"}
                    </span>
                </div>
            </a>
        )
    }

    {
        rest.length > 0 && (
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {rest.map((entry) => (
                    <BNewsCard entry={entry} />
                ))}
            </div>
        )
    }

    {!lead && <p class="text-secondary">No news yet. Stay tuned!</p>}
</Layout>

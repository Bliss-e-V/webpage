---
export const prerender = true;

import EventPage from "@components/events/EventPage.astro";
---

<EventPage
    kind="speaker"
    title="Speaker Series"
    heading="Speaker Series"
    description="In-person talks by leading AI and machine learning researchers, every two weeks in Berlin. See upcoming Speaker Series events and recordings of past talks."
    emptyMessage="No speaker series events scheduled. Stay tuned!"
>
    <div class="mb-10">
        <p class="text-secondary text-md sm:text-lg">
            During the semester, we host leading experts in AI every two weeks.
            These events take place in-person in Berlin (no hybrid option).
            Talks are recorded and published afterwards on our <a href="https://www.youtube.com/@bliss.ev.berlin" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-white underline">YouTube channel</a>.
            Join us to learn from the best in the field and connect with the community!
        </p>
    </div>
</EventPage>
